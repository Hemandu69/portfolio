# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for multiple origins)
FRONTEND_URL=https://www.hemandu.com,https://hemandu.com,http://localhost:3000

# Resend HTTP API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email Destination (where you want to receive portfolio contact messages)
CONTACT_EMAIL=hemen@example.com

# Verified Sender Address in Resend (must match a verified domain/sender in your Resend account)
FROM_EMAIL="Hemandu Portfolio" <hello@hemandu.com>
